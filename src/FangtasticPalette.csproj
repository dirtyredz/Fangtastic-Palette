<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>FangtasticPalette</AssemblyName>
    <RootNamespace>FangtasticPalette</RootNamespace>
    <Version>1.0.1</Version>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ModDeployPath>$(MoonlightPeaksPluginDeployPath)\FangtasticPalette</ModDeployPath>
    <!-- The game ships its own copies of every assembly below; never copy them next to the plugin. -->
    <AssemblySearchPaths>$(AssemblySearchPaths);$(MoonlightPeaksManagedPath)</AssemblySearchPaths>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(MoonlightPeaksBepInExCorePath)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MoonlightPeaksBepInExCorePath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(MoonlightPeaksManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(MoonlightPeaksManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(MoonlightPeaksManagedPath)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- UI stack, needed once the recolour grows a wardrobe tab like PurrtasticPalette's. Kept
         referenced from the probe phase so adding that UI later needs no csproj change. -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(MoonlightPeaksManagedPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(MoonlightPeaksManagedPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(MoonlightPeaksManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(MoonlightPeaksManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(MoonlightPeaksManagedPath)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ParticleSystem, to hide/suppress the form's glow VFX in a wardrobe preview later. -->
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(MoonlightPeaksManagedPath)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Animator, to freeze the preview bat's flap animation. -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(MoonlightPeaksManagedPath)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Volume/Bloom, to suppress the post-processing bloom that smears a preview later. -->
    <Reference Include="Unity.RenderPipelines.Core.Runtime">
      <HintPath>$(MoonlightPeaksManagedPath)\Unity.RenderPipelines.Core.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime">
      <HintPath>$(MoonlightPeaksManagedPath)\Unity.RenderPipelines.Universal.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>


    <Reference Include="Vampire.Runtime">
      <HintPath>$(MoonlightPeaksManagedPath)\Vampire.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LittleChickenGameCompany.Chicken-Utilities.Runtime">
      <HintPath>$(MoonlightPeaksManagedPath)\LittleChickenGameCompany.Chicken-Utilities.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UIScreen/ListWidget/MenuWidget base types - needed once the mod touches the wardrobe
         screen's own widgets, not just materials. -->
    <Reference Include="LittleChickenGameCompany.Chicken-UI.Runtime">
      <HintPath>$(MoonlightPeaksManagedPath)\LittleChickenGameCompany.Chicken-UI.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The default Bat Form tab icon, embedded so it ships inside the DLL - the release zip
       (pack.ps1) bundles only the DLL, so a built-in default has to live within it. A user PNG at
       BepInEx/config/FangtasticPalette/tab-icon.png still overrides it. LogicalName pins the
       resource name regardless of the file's on-disk folder. -->
  <ItemGroup>
    <EmbeddedResource Include="..\assets\tab-icon.png">
      <LogicalName>FangtasticPalette.tab-icon.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <MakeDir Directories="$(ModDeployPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployPath)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed $(AssemblyName).dll -> $(ModDeployPath)" />
  </Target>

</Project>
